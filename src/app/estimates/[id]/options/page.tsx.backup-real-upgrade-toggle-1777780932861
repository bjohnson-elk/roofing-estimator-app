"use client";

import AppSidebar from "@/components/AppSidebar";
import Link from "next/link";
import { useEffect, useMemo, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import { supabase } from "@/lib/supabase";

type Estimate = {
  id: string;
  customer_name: string | null;
  property_address: string | null;
  status: string | null;
  selected_option_name: string | null;
  selected_option_price: number | null;
};

type ProposalConfig = {
  id: string;
  estimate_id: string;
  proposal_type: string;
  single_option_id: string | null;
  option_a_id: string | null;
  option_b_id: string | null;
  good_option_id: string | null;
  better_option_id: string | null;
  best_option_id: string | null;
};

type OptionRow = Record<string, unknown>;

type UpgradeSelection = {
  id: string;
  estimate_option_id: string;
  upgrade_name: string;
  upgrade_group: string;
  is_active: boolean;
};

const proposalTypes = [
  "Single Estimate",
  "Cheapest Option",
  "Option A/B",
  "Good Better Best",
];

const upgradeDefinitions = [
  {
    name: "Standard Ridge Vent",
    group: "Ridge Vent",
  },
  {
    name: "Upgraded Ridge Vent",
    group: "Ridge Vent",
  },
  {
    name: "System Plus",
    group: "Warranty",
  },
  {
    name: "Silver Pledge",
    group: "Warranty",
  },
];

function formatMoney(value: number | null | undefined) {
  if (value === null || value === undefined || Number.isNaN(value)) {
    return "Not Priced";
  }

  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(value);
}

function formatPercent(value: number | null | undefined) {
  if (value === null || value === undefined || Number.isNaN(value)) {
    return "—";
  }

  return `${Number(value).toFixed(1)}%`;
}

function getStatusBadge(status: string | null) {
  const base =
    "inline-flex items-center whitespace-nowrap rounded-md px-2.5 py-0.5 text-[11px] font-bold";

  switch (status) {
    case "Draft - Pending Measurements":
      return `${base} bg-amber-100 text-amber-700`;
    case "Draft - Pending Information":
      return `${base} bg-orange-100 text-orange-700`;
    case "Proposal Created":
      return `${base} bg-blue-100 text-blue-700`;
    case "Proposal Sent":
      return `${base} bg-violet-100 text-violet-700`;
    case "Proposal Signed":
      return `${base} bg-green-100 text-green-700`;
    case "Orders Created":
      return `${base} bg-cyan-100 text-cyan-700`;
    case "Orders Sent":
      return `${base} bg-blue-100 text-blue-700`;
    case "Lost":
      return `${base} bg-slate-200 text-slate-700`;
    case "Archived":
      return `${base} bg-slate-100 text-slate-500`;
    default:
      return `${base} bg-slate-100 text-slate-600`;
  }
}

function readString(row: OptionRow, keys: string[], fallback = "Option") {
  for (const key of keys) {
    const value = row[key];

    if (typeof value === "string" && value.trim()) {
      return value;
    }
  }

  return fallback;
}

function readNumber(row: OptionRow, keys: string[]) {
  for (const key of keys) {
    const value = row[key];

    if (typeof value === "number") {
      return value;
    }

    if (typeof value === "string" && value.trim() !== "") {
      const parsed = Number(value);
      if (!Number.isNaN(parsed)) return parsed;
    }
  }

  return null;
}

function getOptionId(row: OptionRow) {
  return readString(
    row,
    ["estimate_option_id", "option_id", "id"],
    ""
  );
}

function getOptionName(row: OptionRow, index: number) {
  return readString(
    row,
    [
      "option_name",
      "template_name",
      "package_name",
      "estimate_option_name",
      "option_label",
      "name",
    ],
    `Option ${index + 1}`
  );
}

function getOptionPrice(row: OptionRow) {
  return readNumber(row, [
    "total_price",
    "subtotal_price",
    "sell_price",
    "sales_price",
    "price",
    "option_price",
  ]);
}

function getOptionCost(row: OptionRow) {
  return readNumber(row, [
    "total_cost",
    "subtotal_cost",
    "cost",
    "option_cost",
  ]);
}

function getGrossProfit(row: OptionRow) {
  return readNumber(row, ["gross_profit", "profit"]);
}

function getGrossMargin(row: OptionRow) {
  return readNumber(row, [
    "gross_margin_percent",
    "gross_margin",
    "margin_percent",
    "margin",
  ]);
}

function getUpgradeDifference(row: OptionRow) {
  return readNumber(row, [
    "upgrade_price_from_primary",
    "price_difference_from_primary",
    "price_difference",
  ]);
}

function getTierLabel(index: number, proposalType: string) {
  if (proposalType === "Good Better Best") {
    if (index === 0) return "Good";
    if (index === 1) return "Better";
    if (index === 2) return "Best";
  }

  if (proposalType === "Option A/B") {
    if (index === 0) return "Option A";
    if (index === 1) return "Option B";
  }

  if (index === 0) return "Base";
  if (index === 1) return "Upgrade";
  if (index === 2) return "Premium";
  return `Option ${index + 1}`;
}

function getOptionSummary(optionName: string, index: number) {
  const lower = optionName.toLowerCase();

  if (lower.includes("natural shadow") || lower.includes("cheapest")) {
    return "Entry roof system using the lowest generated option.";
  }

  if (lower.includes("hdz") && lower.includes("high")) {
    return "HDZ package with upgraded ridge profile.";
  }

  if (lower.includes("hdz")) {
    return "HDZ package with stronger customer-facing shingle value.";
  }

  if (lower.includes("uhdz")) {
    return "Premium UHDZ package with higher-end shingle profile.";
  }

  if (lower.includes("grand sequoia")) {
    return "Designer shingle option for a premium presentation.";
  }

  return index === 0
    ? "Base generated estimate option."
    : "Higher tier generated estimate option.";
}

function getAddsText(optionName: string, index: number) {
  const lower = optionName.toLowerCase();
  const adds: string[] = [];

  if (index === 0) {
    adds.push("Base roof replacement scope");
  } else {
    adds.push("Upgrade from previous lower-priced option");
  }

  if (lower.includes("hdz")) adds.push("HDZ shingle system");
  if (lower.includes("uhdz")) adds.push("UHDZ premium shingle system");
  if (lower.includes("grand sequoia")) adds.push("Designer shingle profile");
  if (lower.includes("high profile")) adds.push("High profile ridge");
  if (lower.includes("standard profile")) adds.push("Standard profile ridge");
  if (lower.includes("full gaf")) adds.push("Expanded GAF component package");
  if (lower.includes("3 component")) adds.push("3-component GAF package");

  return adds;
}

function OptionSelect({
  label,
  value,
  options,
  onChange,
}: {
  label: string;
  value: string;
  options: OptionRow[];
  onChange: (value: string) => void;
}) {
  return (
    <div>
      <label className="mb-1.5 block text-xs font-black uppercase tracking-wide text-slate-500">
        {label}
      </label>
      <select
        value={value}
        onChange={(event) => onChange(event.target.value)}
        className="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold"
      >
        <option value="">Select option</option>
        {options.map((option, index) => {
          const optionId = getOptionId(option);
          const optionName = getOptionName(option, index);
          const price = getOptionPrice(option);

          return (
            <option key={optionId || optionName} value={optionId}>
              {optionName} — {formatMoney(price)}
            </option>
          );
        })}
      </select>
    </div>
  );
}

export default function EstimateOptionsPage() {
  const router = useRouter();
  const params = useParams();

  const estimateId =
    typeof params.id === "string" ? params.id : params.id?.[0] ?? "";

  const [estimate, setEstimate] = useState<Estimate | null>(null);
  const [proposalConfig, setProposalConfig] = useState<ProposalConfig | null>(
    null
  );
  const [options, setOptions] = useState<OptionRow[]>([]);
  const [upgradeSelections, setUpgradeSelections] = useState<UpgradeSelection[]>([]);
  const [loading, setLoading] = useState(true);
  const [savingConfig, setSavingConfig] = useState(false);
  const [selecting, setSelecting] = useState<string | null>(null);
  const [applyingUpgrade, setApplyingUpgrade] = useState<string | null>(null);
  const [errorMessage, setErrorMessage] = useState("");
  const [successMessage, setSuccessMessage] = useState("");

  async function loadPage() {
    if (!estimateId) return;

    setErrorMessage("");

    const { data: estimateData, error: estimateError } = await supabase
      .from("estimates")
      .select(
        "id, customer_name, property_address, status, selected_option_name, selected_option_price"
      )
      .eq("id", estimateId)
      .single();

    if (estimateError) {
      setErrorMessage(estimateError.message);
      setLoading(false);
      return;
    }

    setEstimate(estimateData as Estimate);

    const { data: optionData, error: optionError } = await supabase
      .from("estimate_option_sales_comparison")
      .select("*")
      .eq("estimate_id", estimateId);

    const loadedOptions = (optionData ?? []) as OptionRow[];

    if (optionError) {
      setErrorMessage(optionError.message);
    } else {
      setOptions(loadedOptions);
    }

    const optionIds = loadedOptions
      .map((option) => getOptionId(option))
      .filter(Boolean);

    if (optionIds.length > 0) {
      const { data: upgradeData, error: upgradeError } = await supabase
        .from("estimate_option_upgrade_selections")
        .select("*")
        .in("estimate_option_id", optionIds);

      if (upgradeError) {
        setErrorMessage(upgradeError.message);
      } else {
        setUpgradeSelections((upgradeData ?? []) as UpgradeSelection[]);
      }
    } else {
      setUpgradeSelections([]);
    }

    const { data: configData, error: configError } = await supabase
      .from("estimate_proposal_configs")
      .select("*")
      .eq("estimate_id", estimateId)
      .maybeSingle();

    if (configError) {
      setErrorMessage(configError.message);
    } else if (configData) {
      setProposalConfig(configData as ProposalConfig);
    } else {
      const cheapestOption = [...((optionData ?? []) as OptionRow[])].sort(
        (a, b) => (getOptionPrice(a) ?? 0) - (getOptionPrice(b) ?? 0)
      )[0];

      const cheapestOptionId = cheapestOption ? getOptionId(cheapestOption) : null;

      const { data: insertedConfig, error: insertError } = await supabase
        .from("estimate_proposal_configs")
        .insert({
          estimate_id: estimateId,
          proposal_type: "Single Estimate",
          single_option_id: cheapestOptionId,
        })
        .select("*")
        .single();

      if (insertError) {
        setErrorMessage(insertError.message);
      } else {
        setProposalConfig(insertedConfig as ProposalConfig);
      }
    }

    setLoading(false);
  }

  useEffect(() => {
    loadPage();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [estimateId]);

  const sortedOptions = useMemo(() => {
    return [...options].sort((a, b) => {
      const priceA = getOptionPrice(a) ?? 0;
      const priceB = getOptionPrice(b) ?? 0;
      return priceA - priceB;
    });
  }, [options]);

  const optionById = useMemo(() => {
    const map = new Map<string, OptionRow>();

    for (const option of sortedOptions) {
      const optionId = getOptionId(option);
      if (optionId) map.set(optionId, option);
    }

    return map;
  }, [sortedOptions]);

  const activeUpgradeSet = useMemo(() => {
    return new Set(
      upgradeSelections
        .filter((selection) => selection.is_active)
        .map(
          (selection) =>
            `${selection.estimate_option_id}-${selection.upgrade_name}`
        )
    );
  }, [upgradeSelections]);

  async function refreshOptionsAndUpgradeSelections() {
    const { data: optionData, error: optionError } = await supabase
      .from("estimate_option_sales_comparison")
      .select("*")
      .eq("estimate_id", estimateId);

    if (optionError) {
      setErrorMessage(optionError.message);
      return;
    }

    const loadedOptions = (optionData ?? []) as OptionRow[];
    setOptions(loadedOptions);

    const optionIds = loadedOptions
      .map((option) => getOptionId(option))
      .filter(Boolean);

    if (optionIds.length === 0) {
      setUpgradeSelections([]);
      return;
    }

    const { data: upgradeData, error: upgradeError } = await supabase
      .from("estimate_option_upgrade_selections")
      .select("*")
      .in("estimate_option_id", optionIds);

    if (upgradeError) {
      setErrorMessage(upgradeError.message);
      return;
    }

    setUpgradeSelections((upgradeData ?? []) as UpgradeSelection[]);
  }

  const displayedOptions = useMemo(() => {
    if (!proposalConfig) return sortedOptions;

    if (proposalConfig.proposal_type === "Cheapest Option") {
      return sortedOptions.slice(0, 1);
    }

    if (proposalConfig.proposal_type === "Single Estimate") {
      const option = proposalConfig.single_option_id
        ? optionById.get(proposalConfig.single_option_id)
        : sortedOptions[0];

      return option ? [option] : [];
    }

    if (proposalConfig.proposal_type === "Option A/B") {
      return [
        proposalConfig.option_a_id
          ? optionById.get(proposalConfig.option_a_id)
          : sortedOptions[0],
        proposalConfig.option_b_id
          ? optionById.get(proposalConfig.option_b_id)
          : sortedOptions[1],
      ].filter(Boolean) as OptionRow[];
    }

    if (proposalConfig.proposal_type === "Good Better Best") {
      return [
        proposalConfig.good_option_id
          ? optionById.get(proposalConfig.good_option_id)
          : sortedOptions[0],
        proposalConfig.better_option_id
          ? optionById.get(proposalConfig.better_option_id)
          : sortedOptions[1],
        proposalConfig.best_option_id
          ? optionById.get(proposalConfig.best_option_id)
          : sortedOptions[2],
      ].filter(Boolean) as OptionRow[];
    }

    return sortedOptions;
  }, [optionById, proposalConfig, sortedOptions]);

  async function updateProposalConfig(update: Partial<ProposalConfig>) {
    if (!estimate || !proposalConfig) return;

    setSavingConfig(true);
    setErrorMessage("");
    setSuccessMessage("");

    const { data, error } = await supabase
      .from("estimate_proposal_configs")
      .update({
        ...update,
        updated_at: new Date().toISOString(),
      })
      .eq("id", proposalConfig.id)
      .select("*")
      .single();

    setSavingConfig(false);

    if (error) {
      setErrorMessage(error.message);
      return;
    }

    setProposalConfig(data as ProposalConfig);
  }

  async function selectOption(row: OptionRow, index: number) {
    if (!estimate) return;

    const optionName = getOptionName(row, index);
    const optionPrice = getOptionPrice(row);

    setSelecting(optionName);
    setErrorMessage("");
    setSuccessMessage("");

    const { error } = await supabase
      .from("estimates")
      .update({
        selected_option_name: optionName,
        selected_option_price: optionPrice,
        selected_option_data: row,
        subtotal_price: optionPrice,
        status: "Proposal Created",
      })
      .eq("id", estimate.id);

    setSelecting(null);

    if (error) {
      setErrorMessage(error.message);
      return;
    }

    setEstimate({
      ...estimate,
      selected_option_name: optionName,
      selected_option_price: optionPrice,
      status: "Proposal Created",
    });

    setSuccessMessage(`${optionName} selected. Proposal status created.`);
  }

  async function applyUpgrade(optionId: string, upgradeName: string) {
    if (!optionId) return;

    setApplyingUpgrade(`${optionId}-${upgradeName}`);
    setErrorMessage("");
    setSuccessMessage("");

    let errorMessage = "";

    if (upgradeName === "Standard Ridge Vent") {
      const { error } = await supabase.rpc("apply_ridge_runner_upgrade", {
        p_estimate_option_id: optionId,
      });
      errorMessage = error?.message ?? "";
    }

    if (upgradeName === "Upgraded Ridge Vent") {
      const { error } = await supabase.rpc("apply_snowcountry_ridge_vent_upgrade", {
        p_estimate_option_id: optionId,
      });
      errorMessage = error?.message ?? "";
    }

    if (upgradeName === "Intake Vents") {
      const { error } = await supabase.rpc("apply_upgrade_preset_to_estimate_option", {
        p_estimate_option_id: optionId,
        p_preset_name: "Intake Vents",
      });
      errorMessage = error?.message ?? "";
    }

    if (upgradeName === "System Plus") {
      const { error } = await supabase.rpc("apply_system_plus_warranty_upgrade", {
        p_estimate_option_id: optionId,
      });
      errorMessage = error?.message ?? "";
    }

    if (upgradeName === "Silver Pledge") {
      const { error } = await supabase.rpc("apply_gaf_warranty_with_cheapest_swaps", {
        p_estimate_option_id: optionId,
        p_warranty_level: "Silver Pledge",
      });
      errorMessage = error?.message ?? "";
    }

    if (errorMessage) {
      setApplyingUpgrade(null);
      setErrorMessage(errorMessage);
      return;
    }

    const upgradeDefinition = upgradeDefinitions.find(
      (upgrade) => upgrade.name === upgradeName
    );

    if (upgradeDefinition) {
      const now = new Date().toISOString();

      const { error: deactivateError } = await supabase
        .from("estimate_option_upgrade_selections")
        .update({
          is_active: false,
          updated_at: now,
        })
        .eq("estimate_option_id", optionId)
        .eq("upgrade_group", upgradeDefinition.group);

      if (deactivateError) {
        setApplyingUpgrade(null);
        setErrorMessage(deactivateError.message);
        return;
      }

      const { error: upsertError } = await supabase
        .from("estimate_option_upgrade_selections")
        .upsert(
          {
            estimate_option_id: optionId,
            upgrade_name: upgradeDefinition.name,
            upgrade_group: upgradeDefinition.group,
            is_active: true,
            updated_at: now,
          },
          {
            onConflict: "estimate_option_id,upgrade_name",
          }
        );

      if (upsertError) {
        setApplyingUpgrade(null);
        setErrorMessage(upsertError.message);
        return;
      }
    }

    setApplyingUpgrade(null);
    setSuccessMessage(`${upgradeName} applied. Option pricing refreshed.`);
    await refreshOptionsAndUpgradeSelections();
  }

  if (loading) {
    return (
      <main className="min-h-screen bg-slate-100 p-6">
        <div className="rounded-lg bg-white p-4 text-sm font-semibold shadow">
          Loading estimate options...
        </div>
      </main>
    );
  }

  if (!estimate) {
    return (
      <main className="min-h-screen bg-slate-100 p-6">
        <div className="rounded-lg bg-white p-5 shadow">
          Estimate not found.
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-100">
      <div className="flex">
        <AppSidebar active="Estimates" />

        <section className="min-h-screen min-w-0 flex-1 p-5 lg:ml-[var(--sidebar-width)]">
          <div className="mx-auto max-w-7xl">
            <div className="mb-5 border-b border-slate-300 pb-5">
              <button
                onClick={() => router.push(`/estimates/${estimate.id}`)}
                className="mb-2 text-xs font-bold text-slate-500 hover:text-slate-900"
              >
                ← Back to Estimate
              </button>

              <div className="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
                <div className="min-w-0">
                  <div className="flex flex-wrap items-center gap-3">
                    <h1 className="text-3xl font-black text-slate-950">
                      Estimate Options
                    </h1>
                    <span className={getStatusBadge(estimate.status)}>
                      {estimate.status || "No Status"}
                    </span>
                  </div>

                  <p className="mt-1 max-w-4xl text-sm font-medium text-slate-600">
                    {estimate.customer_name || "Unnamed Customer"} ·{" "}
                    {estimate.property_address || "No address"}
                  </p>
                </div>

                {estimate.selected_option_name && (
                  <div className="rounded-lg bg-white px-4 py-3 text-sm shadow-sm ring-1 ring-slate-200">
                    <div className="font-black text-slate-900">
                      Selected: {estimate.selected_option_name}
                    </div>
                    <div className="text-slate-600">
                      {formatMoney(estimate.selected_option_price)}
                    </div>
                  </div>
                )}
              </div>
            </div>

            {errorMessage && (
              <div className="mb-5 rounded-lg bg-red-50 p-3 text-sm font-semibold text-red-700">
                {errorMessage}
              </div>
            )}

            {successMessage && (
              <div className="mb-5 rounded-lg bg-green-50 p-3 text-sm font-semibold text-green-700">
                {successMessage}
              </div>
            )}

            {sortedOptions.length === 0 ? (
              <div className="rounded-lg border border-slate-200 bg-white p-8 text-center shadow-sm">
                <h2 className="text-xl font-black text-slate-900">
                  No estimate options found
                </h2>
                <p className="mx-auto mt-2 max-w-2xl text-sm text-slate-600">
                  No rows were returned from estimate_option_sales_comparison for this estimate.
                </p>

                <Link
                  href={`/estimates/${estimate.id}/questions`}
                  className="mt-5 inline-flex rounded-lg bg-blue-600 px-5 py-3 text-sm font-black text-white hover:bg-blue-700"
                >
                  Back to Job Questions
                </Link>
              </div>
            ) : (
              <div className="grid gap-4 xl:grid-cols-[minmax(0,1fr)_340px]">
                <div className="min-w-0 space-y-4">
                  <div className="rounded-lg border border-slate-200 bg-white shadow-sm">
                    <div className="border-b border-slate-200 px-4 py-3">
                      <h2 className="text-xs font-black uppercase tracking-wide text-slate-800">
                        Proposal Type
                      </h2>
                    </div>

                    <div className="grid gap-2 p-4 md:grid-cols-4">
                      {proposalTypes.map((type) => (
                        <button
                          key={type}
                          type="button"
                          onClick={() =>
                            updateProposalConfig({
                              proposal_type: type,
                            } as Partial<ProposalConfig>)
                          }
                          disabled={savingConfig}
                          className={`rounded-lg border px-3 py-2 text-left text-xs font-black ${
                            proposalConfig?.proposal_type === type
                              ? "border-blue-300 bg-blue-50 text-blue-800"
                              : "border-slate-300 bg-white text-slate-700 hover:bg-slate-50"
                          }`}
                        >
                          {type}
                        </button>
                      ))}
                    </div>
                  </div>

                  {proposalConfig && (
                    <div className="rounded-lg border border-slate-200 bg-white shadow-sm">
                      <div className="border-b border-slate-200 px-4 py-3">
                        <h2 className="text-xs font-black uppercase tracking-wide text-slate-800">
                          Option Assignment
                        </h2>
                      </div>

                      <div className="grid gap-3 p-4 md:grid-cols-2">
                        {proposalConfig.proposal_type === "Single Estimate" && (
                          <OptionSelect
                            label="Single Estimate"
                            value={proposalConfig.single_option_id ?? ""}
                            options={sortedOptions}
                            onChange={(value) =>
                              updateProposalConfig({
                                single_option_id: value,
                              } as Partial<ProposalConfig>)
                            }
                          />
                        )}

                        {proposalConfig.proposal_type === "Option A/B" && (
                          <>
                            <OptionSelect
                              label="Option A"
                              value={proposalConfig.option_a_id ?? ""}
                              options={sortedOptions}
                              onChange={(value) =>
                                updateProposalConfig({
                                  option_a_id: value,
                                } as Partial<ProposalConfig>)
                              }
                            />

                            <OptionSelect
                              label="Option B"
                              value={proposalConfig.option_b_id ?? ""}
                              options={sortedOptions}
                              onChange={(value) =>
                                updateProposalConfig({
                                  option_b_id: value,
                                } as Partial<ProposalConfig>)
                              }
                            />
                          </>
                        )}

                        {proposalConfig.proposal_type === "Good Better Best" && (
                          <>
                            <OptionSelect
                              label="Good"
                              value={proposalConfig.good_option_id ?? ""}
                              options={sortedOptions}
                              onChange={(value) =>
                                updateProposalConfig({
                                  good_option_id: value,
                                } as Partial<ProposalConfig>)
                              }
                            />

                            <OptionSelect
                              label="Better"
                              value={proposalConfig.better_option_id ?? ""}
                              options={sortedOptions}
                              onChange={(value) =>
                                updateProposalConfig({
                                  better_option_id: value,
                                } as Partial<ProposalConfig>)
                              }
                            />

                            <OptionSelect
                              label="Best"
                              value={proposalConfig.best_option_id ?? ""}
                              options={sortedOptions}
                              onChange={(value) =>
                                updateProposalConfig({
                                  best_option_id: value,
                                } as Partial<ProposalConfig>)
                              }
                            />
                          </>
                        )}

                        {proposalConfig.proposal_type === "Cheapest Option" && (
                          <div className="rounded-lg bg-slate-50 p-3 text-sm font-semibold text-slate-700 md:col-span-2">
                            Cheapest option is selected automatically from generated pricing.
                          </div>
                        )}
                      </div>
                    </div>
                  )}

                  <div className="grid gap-4 lg:grid-cols-2 2xl:grid-cols-3">
                    {displayedOptions.map((row, index) => {
                      const optionName = getOptionName(row, index);
                      const optionId = getOptionId(row);
                      const price = getOptionPrice(row);
                      const cost = getOptionCost(row);
                      const profit = getGrossProfit(row);
                      const margin = getGrossMargin(row);
                      const upgradeDifference = getUpgradeDifference(row);
                      const tierLabel = getTierLabel(
                        index,
                        proposalConfig?.proposal_type ?? "Single Estimate"
                      );

                      const isSelected =
                        estimate.selected_option_name === optionName;

                      const adds = getAddsText(optionName, index);

                      return (
                        <div
                          key={`${optionId}-${index}`}
                          className={`rounded-xl border bg-white shadow-sm ${
                            isSelected
                              ? "border-blue-600 ring-2 ring-blue-100"
                              : "border-slate-200"
                          }`}
                        >
                          <div className="border-b border-slate-200 p-4">
                            <div className="flex items-center justify-between gap-3">
                              <span className="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-black uppercase tracking-wide text-slate-600">
                                {tierLabel}
                              </span>

                              {isSelected && (
                                <span className="rounded-full bg-blue-100 px-3 py-1 text-[11px] font-bold text-blue-700">
                                  Selected
                                </span>
                              )}
                            </div>

                            <h2 className="mt-3 text-xl font-black text-slate-900">
                              {optionName}
                            </h2>

                            <p className="mt-1 text-xs font-semibold text-slate-500">
                              {getOptionSummary(optionName, index)}
                            </p>

                            <div className="mt-4 text-3xl font-black text-slate-900">
                              {formatMoney(price)}
                            </div>

                            {index > 0 && upgradeDifference !== null && (
                              <div className="mt-1 text-xs font-black text-blue-700">
                                +{formatMoney(upgradeDifference)} from base
                              </div>
                            )}
                          </div>

                          <div className="space-y-2 border-b border-slate-200 p-4 text-sm">
                            <div className="flex justify-between">
                              <span className="text-slate-500">Cost</span>
                              <span className="font-bold text-slate-900">
                                {formatMoney(cost)}
                              </span>
                            </div>

                            <div className="flex justify-between">
                              <span className="text-slate-500">Profit</span>
                              <span className="font-bold text-slate-900">
                                {formatMoney(profit)}
                              </span>
                            </div>

                            <div className="flex justify-between">
                              <span className="text-slate-500">Margin</span>
                              <span className="font-bold text-slate-900">
                                {formatPercent(margin)}
                              </span>
                            </div>
                          </div>

                          <div className="border-b border-slate-200 p-4">
                            <div className="text-xs font-black uppercase tracking-wide text-slate-500">
                              Adds / Includes
                            </div>

                            <ul className="mt-2 space-y-1 text-sm font-semibold text-slate-700">
                              {adds.map((item) => (
                                <li key={item}>• {item}</li>
                              ))}
                            </ul>
                          </div>

                          <div className="border-b border-slate-200 p-4">
                            <div className="text-xs font-black uppercase tracking-wide text-slate-500">
                              Available Upgrades
                            </div>

                            <div className="mt-3 grid gap-2">
                              {upgradeDefinitions.map((upgrade) => {
                                const active = activeUpgradeSet.has(
                                  `${optionId}-${upgrade.name}`
                                );
                                const key = `${optionId}-${upgrade.name}`;
                                const isApplying = applyingUpgrade === key;

                                return (
                                  <button
                                    key={upgrade.name}
                                    type="button"
                                    onClick={() =>
                                      applyUpgrade(optionId, upgrade.name)
                                    }
                                    disabled={isApplying}
                                    className={`rounded-md border px-3 py-2 text-left text-xs font-bold disabled:opacity-50 ${
                                      active
                                        ? "border-green-300 bg-green-50 text-green-700"
                                        : "border-slate-300 bg-white text-slate-700 hover:bg-slate-50"
                                    }`}
                                  >
                                    {isApplying
                                      ? "Applying..."
                                      : active
                                      ? `${upgrade.name} ✓`
                                      : upgrade.name}
                                  </button>
                                );
                              })}
                            </div>
                          </div>

                          <div className="p-4">
                            <button
                              onClick={() => selectOption(row, index)}
                              disabled={selecting === optionName}
                              className={`w-full rounded-lg px-4 py-2.5 text-sm font-black ${
                                isSelected
                                  ? "bg-slate-900 text-white"
                                  : "bg-blue-600 text-white hover:bg-blue-700"
                              } disabled:opacity-50`}
                            >
                              {selecting === optionName
                                ? "Saving..."
                                : isSelected
                                ? "Selected"
                                : "Select for Proposal"}
                            </button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>

                <aside className="space-y-4">
                  <div className="rounded-lg border border-slate-200 bg-white shadow-sm">
                    <div className="border-b border-slate-200 px-4 py-3">
                      <h2 className="text-xs font-black uppercase tracking-wide text-slate-800">
                        Next Step
                      </h2>
                    </div>

                    <div className="space-y-3 p-4">
                      <p className="text-sm font-medium text-slate-600">
                        Pick the proposal type, assign options, then continue to proposal.
                      </p>

                      <Link
                        href={`/estimates/${estimate.id}/proposal`}
                        className={`block rounded-lg px-4 py-2.5 text-center text-sm font-black ${
                          estimate.selected_option_name || proposalConfig
                            ? "bg-blue-600 text-white hover:bg-blue-700"
                            : "bg-slate-200 text-slate-500"
                        }`}
                      >
                        Continue to Proposal
                      </Link>
                    </div>
                  </div>

                  <div className="rounded-lg border border-slate-200 bg-white shadow-sm">
                    <div className="border-b border-slate-200 px-4 py-3">
                      <h2 className="text-xs font-black uppercase tracking-wide text-slate-800">
                        Edit / Jump To
                      </h2>
                    </div>

                    <div className="space-y-2 p-4">
                      <Link
                        href={`/estimates/${estimate.id}/edit`}
                        className="block rounded-md border border-slate-300 bg-white px-3 py-2 text-center text-xs font-bold text-slate-700 hover:bg-slate-50"
                      >
                        Review / Edit Initial Info
                      </Link>

                      <Link
                        href={`/estimates/${estimate.id}/questions`}
                        className="block rounded-md border border-slate-300 bg-white px-3 py-2 text-center text-xs font-bold text-slate-700 hover:bg-slate-50"
                      >
                        Job Questions
                      </Link>

                      <Link
                        href={`/estimates/${estimate.id}`}
                        className="block rounded-md border border-slate-300 bg-white px-3 py-2 text-center text-xs font-bold text-slate-700 hover:bg-slate-50"
                      >
                        Estimate Detail
                      </Link>
                    </div>
                  </div>
                </aside>
              </div>
            )}
          </div>
        </section>
      </div>
    </main>
  );
}
