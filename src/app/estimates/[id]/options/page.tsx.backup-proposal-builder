"use client";

import AppSidebar from "@/components/AppSidebar";

import Link from "next/link";
import { useEffect, useMemo, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import { supabase } from "@/lib/supabase";

type Estimate = {
  id: string;
  customer_name: string | null;
  property_address: string | null;
  status: string | null;
  selected_option_name: string | null;
  selected_option_price: number | null;
};

type OptionRow = Record<string, unknown>;

function formatMoney(value: number | null | undefined) {
  if (value === null || value === undefined || Number.isNaN(value)) {
    return "Not Priced";
  }

  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(value);
}

function formatPercent(value: number | null | undefined) {
  if (value === null || value === undefined || Number.isNaN(value)) {
    return "—";
  }

  return `${Number(value).toFixed(1)}%`;
}

function getStatusBadge(status: string | null) {
  const base = "rounded-md px-3 py-1 text-xs font-semibold";

  switch (status) {
    case "Draft - Pending Measurements":
      return `${base} bg-amber-100 text-amber-700`;
    case "Draft - Pending Information":
      return `${base} bg-orange-100 text-orange-700`;
    case "Proposal Created":
      return `${base} bg-blue-100 text-blue-700`;
    case "Proposal Sent":
      return `${base} bg-violet-100 text-violet-700`;
    case "Proposal Signed":
      return `${base} bg-green-100 text-green-700`;
    case "Orders Created":
      return `${base} bg-cyan-100 text-cyan-700`;
    case "Orders Sent":
      return `${base} bg-blue-100 text-blue-700`;
    case "Lost":
      return `${base} bg-slate-200 text-slate-700`;
    case "Archived":
      return `${base} bg-slate-100 text-slate-500`;
    default:
      return `${base} bg-slate-100 text-slate-600`;
  }
}

function readString(row: OptionRow, keys: string[], fallback = "Option") {
  for (const key of keys) {
    const value = row[key];

    if (typeof value === "string" && value.trim()) {
      return value;
    }
  }

  return fallback;
}

function readNumber(row: OptionRow, keys: string[]) {
  for (const key of keys) {
    const value = row[key];

    if (typeof value === "number") {
      return value;
    }

    if (typeof value === "string" && value.trim() !== "") {
      const parsed = Number(value);
      if (!Number.isNaN(parsed)) return parsed;
    }
  }

  return null;
}

function getOptionName(row: OptionRow, index: number) {
  return readString(
    row,
    [
      "option_name",
      "template_name",
      "package_name",
      "estimate_option_name",
      "option_label",
      "name",
    ],
    `Option ${index + 1}`
  );
}

function getOptionPrice(row: OptionRow) {
  return readNumber(row, [
    "total_price",
    "subtotal_price",
    "sell_price",
    "sales_price",
    "price",
    "option_price",
  ]);
}

function getOptionCost(row: OptionRow) {
  return readNumber(row, [
    "total_cost",
    "subtotal_cost",
    "cost",
    "option_cost",
  ]);
}

function getGrossProfit(row: OptionRow) {
  return readNumber(row, ["gross_profit", "profit"]);
}

function getGrossMargin(row: OptionRow) {
  return readNumber(row, [
    "gross_margin_percent",
    "gross_margin",
    "margin_percent",
    "margin",
  ]);
}

function getPackageLabel(index: number) {
  if (index === 0) return "Good";
  if (index === 1) return "Better";
  if (index === 2) return "Best";
  return `Option ${index + 1}`;
}

export default function EstimateOptionsPage() {
  const router = useRouter();
  const params = useParams();

  const estimateId =
    typeof params.id === "string" ? params.id : params.id?.[0] ?? "";

  const [estimate, setEstimate] = useState<Estimate | null>(null);
  const [options, setOptions] = useState<OptionRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [selecting, setSelecting] = useState<string | null>(null);
  const [errorMessage, setErrorMessage] = useState("");
  const [successMessage, setSuccessMessage] = useState("");

  useEffect(() => {
    async function loadPage() {
      if (!estimateId) return;

      const { data: estimateData, error: estimateError } = await supabase
        .from("estimates")
        .select(
          "id, customer_name, property_address, status, selected_option_name, selected_option_price"
        )
        .eq("id", estimateId)
        .single();

      if (estimateError) {
        setErrorMessage(estimateError.message);
        setLoading(false);
        return;
      }

      setEstimate(estimateData as Estimate);

      const { data: optionData, error: optionError } = await supabase
        .from("estimate_option_sales_comparison")
        .select("*")
        .eq("estimate_id", estimateId);

      if (optionError) {
        setErrorMessage(optionError.message);
      } else {
        setOptions((optionData ?? []) as OptionRow[]);
      }

      setLoading(false);
    }

    loadPage();
  }, [estimateId]);

  const sortedOptions = useMemo(() => {
    return [...options].sort((a, b) => {
      const priceA = getOptionPrice(a) ?? 0;
      const priceB = getOptionPrice(b) ?? 0;
      return priceA - priceB;
    });
  }, [options]);

  async function selectOption(row: OptionRow, index: number) {
    if (!estimate) return;

    const optionName = getOptionName(row, index);
    const optionPrice = getOptionPrice(row);

    setSelecting(optionName);
    setErrorMessage("");
    setSuccessMessage("");

    const { error } = await supabase
      .from("estimates")
      .update({
        selected_option_name: optionName,
        selected_option_price: optionPrice,
        selected_option_data: row,
        subtotal_price: optionPrice,
        status: "Proposal Created",
      })
      .eq("id", estimate.id);

    setSelecting(null);

    if (error) {
      setErrorMessage(error.message);
      return;
    }

    setEstimate({
      ...estimate,
      selected_option_name: optionName,
      selected_option_price: optionPrice,
      status: "Proposal Created",
    });

    setSuccessMessage(`${optionName} selected. Proposal status created.`);
  }

  if (loading) {
    return (
      <main className="min-h-screen bg-slate-100 p-8">
        <div className="rounded-xl bg-white p-6 shadow">
          Loading estimate options...
        </div>
      </main>
    );
  }

  if (!estimate) {
    return (
      <main className="min-h-screen bg-slate-100 p-8">
        <div className="rounded-xl bg-white p-6 shadow">
          Estimate not found.
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-100">
      <div className="flex">
        <AppSidebar active="Estimates" />

        <section className="min-h-screen flex-1 p-6 lg:ml-[var(--sidebar-width)]">
          <div className="mb-6 flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
            <div>
              <button
                onClick={() => router.push(`/estimates/${estimate.id}`)}
                className="mb-3 text-sm font-bold text-slate-600 hover:text-slate-900"
              >
                ← Back to Estimate
              </button>

              <h1 className="text-4xl font-bold text-slate-900">
                Estimate Options
              </h1>

              <p className="mt-1 text-lg text-slate-600">
                {estimate.customer_name || "Unnamed Customer"} ·{" "}
                {estimate.property_address || "No address"}
              </p>
            </div>

            <div className="flex flex-col items-start gap-3 xl:items-end">
              <span className={getStatusBadge(estimate.status)}>
                {estimate.status || "No Status"}
              </span>

              {estimate.selected_option_name && (
                <div className="rounded-lg bg-white px-4 py-3 text-sm shadow-sm ring-1 ring-slate-200">
                  <div className="font-bold text-slate-900">
                    Selected: {estimate.selected_option_name}
                  </div>
                  <div className="text-slate-600">
                    {formatMoney(estimate.selected_option_price)}
                  </div>
                </div>
              )}
            </div>
          </div>

          {errorMessage && (
            <div className="mb-6 rounded-lg bg-red-50 p-4 text-sm font-semibold text-red-700">
              {errorMessage}
            </div>
          )}

          {successMessage && (
            <div className="mb-6 rounded-lg bg-green-50 p-4 text-sm font-semibold text-green-700">
              {successMessage}
            </div>
          )}

          {sortedOptions.length === 0 ? (
            <div className="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
              <h2 className="text-2xl font-bold text-slate-900">
                No estimate options found
              </h2>
              <p className="mx-auto mt-2 max-w-2xl text-slate-600">
                This page is connected to the Supabase view{" "}
                <strong>estimate_option_sales_comparison</strong>. No rows were
                returned for this estimate ID yet.
              </p>

              <div className="mt-6 flex justify-center gap-3">
                <Link
                  href={`/estimates/${estimate.id}/questions`}
                  className="rounded-lg bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700"
                >
                  Back to Job Questions
                </Link>

                <Link
                  href={`/estimates/${estimate.id}`}
                  className="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50"
                >
                  Estimate Detail
                </Link>
              </div>
            </div>
          ) : (
            <div className="grid gap-6 xl:grid-cols-[1fr_340px]">
              <div>
                <div className="grid gap-5 md:grid-cols-3">
                  {sortedOptions.map((row, index) => {
                    const optionName = getOptionName(row, index);
                    const packageLabel = getPackageLabel(index);
                    const price = getOptionPrice(row);
                    const cost = getOptionCost(row);
                    const profit = getGrossProfit(row);
                    const margin = getGrossMargin(row);

                    const isSelected =
                      estimate.selected_option_name === optionName;

                    return (
                      <div
                        key={`${optionName}-${index}`}
                        className={`rounded-2xl border bg-white shadow-sm ${
                          isSelected
                            ? "border-blue-600 ring-2 ring-blue-100"
                            : "border-slate-200"
                        }`}
                      >
                        <div className="border-b border-slate-200 p-5">
                          <div className="flex items-center justify-between">
                            <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-black uppercase tracking-wide text-slate-600">
                              {packageLabel}
                            </span>

                            {isSelected && (
                              <span className="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-700">
                                Selected
                              </span>
                            )}
                          </div>

                          <h2 className="mt-4 text-2xl font-black text-slate-900">
                            {optionName}
                          </h2>

                          <div className="mt-4 text-4xl font-black text-slate-900">
                            {formatMoney(price)}
                          </div>

                          <div className="mt-1 text-sm text-slate-500">
                            Customer price
                          </div>
                        </div>

                        <div className="space-y-3 p-5 text-sm">
                          <div className="flex justify-between">
                            <span className="text-slate-500">Cost</span>
                            <span className="font-bold text-slate-900">
                              {formatMoney(cost)}
                            </span>
                          </div>

                          <div className="flex justify-between">
                            <span className="text-slate-500">Gross Profit</span>
                            <span className="font-bold text-slate-900">
                              {formatMoney(profit)}
                            </span>
                          </div>

                          <div className="flex justify-between">
                            <span className="text-slate-500">Gross Margin</span>
                            <span className="font-bold text-slate-900">
                              {formatPercent(margin)}
                            </span>
                          </div>
                        </div>

                        <div className="border-t border-slate-200 p-5">
                          <button
                            onClick={() => selectOption(row, index)}
                            disabled={selecting === optionName}
                            className={`w-full rounded-lg px-5 py-3 text-sm font-bold ${
                              isSelected
                                ? "bg-slate-900 text-white"
                                : "bg-blue-600 text-white hover:bg-blue-700"
                            } disabled:opacity-50`}
                          >
                            {selecting === optionName
                              ? "Saving..."
                              : isSelected
                              ? "Selected"
                              : "Select Option"}
                          </button>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <div className="mt-6 rounded-xl border border-slate-200 bg-white shadow-sm">
                  <div className="border-b border-slate-200 px-5 py-4">
                    <h2 className="text-sm font-black uppercase tracking-wide text-slate-800">
                      Raw Option Data
                    </h2>
                  </div>

                  <div className="overflow-x-auto p-5">
                    <table className="w-full border-collapse text-sm">
                      <thead>
                        <tr className="border-b border-slate-200 text-left text-xs font-bold uppercase tracking-wide text-slate-500">
                          <th className="px-3 py-2">Option</th>
                          <th className="px-3 py-2">Price</th>
                          <th className="px-3 py-2">Cost</th>
                          <th className="px-3 py-2">Profit</th>
                          <th className="px-3 py-2">Margin</th>
                        </tr>
                      </thead>

                      <tbody>
                        {sortedOptions.map((row, index) => (
                          <tr
                            key={`table-${index}`}
                            className="border-b border-slate-100"
                          >
                            <td className="px-3 py-3 font-semibold text-slate-900">
                              {getOptionName(row, index)}
                            </td>
                            <td className="px-3 py-3">
                              {formatMoney(getOptionPrice(row))}
                            </td>
                            <td className="px-3 py-3">
                              {formatMoney(getOptionCost(row))}
                            </td>
                            <td className="px-3 py-3">
                              {formatMoney(getGrossProfit(row))}
                            </td>
                            <td className="px-3 py-3">
                              {formatPercent(getGrossMargin(row))}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <aside className="space-y-6">
                <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                  <div className="border-b border-slate-200 px-5 py-4">
                    <h2 className="text-sm font-black uppercase tracking-wide text-slate-800">
                      Next Step
                    </h2>
                  </div>

                  <div className="space-y-4 p-5">
                    <p className="text-sm text-slate-600">
                      Select one estimate option to create the proposal.
                    </p>

                    <Link
                      href={`/estimates/${estimate.id}/proposal`}
                      className={`block rounded-lg px-5 py-3 text-center text-sm font-bold ${
                        estimate.selected_option_name
                          ? "bg-blue-600 text-white hover:bg-blue-700"
                          : "bg-slate-200 text-slate-500"
                      }`}
                    >
                      Continue to Proposal
                    </Link>
                  </div>
                </div>

                <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                  <div className="border-b border-slate-200 px-5 py-4">
                    <h2 className="text-sm font-black uppercase tracking-wide text-slate-800">
                      Quick Links
                    </h2>
                  </div>

                  <div className="space-y-3 p-5">
                    <Link
                      href={`/estimates/${estimate.id}/questions`}
                      className="block rounded-lg border border-slate-300 px-4 py-3 text-center text-sm font-bold text-slate-700 hover:bg-slate-50"
                    >
                      Job Questions
                    </Link>

                    <Link
                      href={`/estimates/${estimate.id}`}
                      className="block rounded-lg border border-slate-300 px-4 py-3 text-center text-sm font-bold text-slate-700 hover:bg-slate-50"
                    >
                      Estimate Detail
                    </Link>

                    <Link
                      href="/estimates"
                      className="block rounded-lg border border-slate-300 px-4 py-3 text-center text-sm font-bold text-slate-700 hover:bg-slate-50"
                    >
                      All Estimates
                    </Link>
                  </div>
                </div>
              </aside>
            </div>
          )}
        </section>
      </div>
    </main>
  );
}