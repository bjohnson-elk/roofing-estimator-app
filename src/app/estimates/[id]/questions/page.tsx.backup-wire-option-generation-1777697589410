"use client";

import AppSidebar from "@/components/AppSidebar";

import Link from "next/link";
import { useEffect, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import { supabase } from "@/lib/supabase";

type Estimate = {
  id: string;
  customer_name: string | null;
  property_address: string | null;
  status: string | null;
  job_type: string | null;

  roof_area_sf: number | null;
  roof_squares: number | null;
  waste_percent: number | null;
  waste_squares: number | null;
  pitch: string | null;
  eaves_lf: number | null;
  rakes_lf: number | null;
  hips_lf: number | null;
  ridges_lf: number | null;
  valleys_lf: number | null;
  flashing_lf: number | null;
  step_flashing_lf: number | null;
  drip_edge_lf: number | null;
  starter_lf: number | null;
  ridge_cap_lf: number | null;
  stories: string | null;

  has_solar: boolean | null;
  has_gutters: boolean | null;
  has_skylights: boolean | null;
  has_chimney: boolean | null;
  needs_cricket: boolean | null;

  payment_type: string | null;
  financing_down_payment: number | null;
  estimate_goal: string | null;

  measurement_verified: boolean | null;
  job_questions_completed: boolean | null;
};

function getStatusBadge(status: string | null) {
  const base = "rounded-md px-3 py-1 text-xs font-semibold";

  switch (status) {
    case "Draft - Pending Measurements":
      return `${base} bg-amber-100 text-amber-700`;
    case "Draft - Pending Information":
      return `${base} bg-orange-100 text-orange-700`;
    case "Proposal Created":
      return `${base} bg-blue-100 text-blue-700`;
    case "Proposal Sent":
      return `${base} bg-violet-100 text-violet-700`;
    case "Proposal Signed":
      return `${base} bg-green-100 text-green-700`;
    case "Orders Created":
      return `${base} bg-cyan-100 text-cyan-700`;
    case "Orders Sent":
      return `${base} bg-blue-100 text-blue-700`;
    case "Lost":
      return `${base} bg-slate-200 text-slate-700`;
    case "Archived":
      return `${base} bg-slate-100 text-slate-500`;
    default:
      return `${base} bg-slate-100 text-slate-600`;
  }
}

function toNumber(value: string) {
  if (value.trim() === "") return null;
  const numberValue = Number(value);
  return Number.isNaN(numberValue) ? null : numberValue;
}

function toInputValue(value: number | null) {
  return value === null || value === undefined ? "" : String(value);
}

export default function JobQuestionsPage() {
  const router = useRouter();
  const params = useParams();

  const estimateId =
    typeof params.id === "string" ? params.id : params.id?.[0] ?? "";

  const [estimate, setEstimate] = useState<Estimate | null>(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  const [errorMessage, setErrorMessage] = useState("");
  const [successMessage, setSuccessMessage] = useState("");

  const [roofAreaSf, setRoofAreaSf] = useState("");
  const [roofSquares, setRoofSquares] = useState("");
  const [wastePercent, setWastePercent] = useState("10");
  const [wasteSquares, setWasteSquares] = useState("");
  const [pitch, setPitch] = useState("");
  const [eavesLf, setEavesLf] = useState("");
  const [rakesLf, setRakesLf] = useState("");
  const [hipsLf, setHipsLf] = useState("");
  const [ridgesLf, setRidgesLf] = useState("");
  const [valleysLf, setValleysLf] = useState("");
  const [flashingLf, setFlashingLf] = useState("");
  const [stepFlashingLf, setStepFlashingLf] = useState("");
  const [dripEdgeLf, setDripEdgeLf] = useState("");
  const [starterLf, setStarterLf] = useState("");
  const [ridgeCapLf, setRidgeCapLf] = useState("");
  const [stories, setStories] = useState("");

  const [jobType, setJobType] = useState("Insurance");
  const [estimateGoal, setEstimateGoal] = useState("Best Value");
  const [paymentType, setPaymentType] = useState("Cash");
  const [financingDownPayment, setFinancingDownPayment] = useState("");

  const [hasSolar, setHasSolar] = useState(false);
  const [hasGutters, setHasGutters] = useState(false);
  const [hasSkylights, setHasSkylights] = useState(false);
  const [hasChimney, setHasChimney] = useState(false);
  const [needsCricket, setNeedsCricket] = useState(false);

  useEffect(() => {
    async function loadEstimate() {
      if (!estimateId) return;

      const { data, error } = await supabase
        .from("estimates")
        .select(
          [
            "id",
            "customer_name",
            "property_address",
            "status",
            "job_type",
            "roof_area_sf",
            "roof_squares",
            "waste_percent",
            "waste_squares",
            "pitch",
            "eaves_lf",
            "rakes_lf",
            "hips_lf",
            "ridges_lf",
            "valleys_lf",
            "flashing_lf",
            "step_flashing_lf",
            "drip_edge_lf",
            "starter_lf",
            "ridge_cap_lf",
            "stories",
            "has_solar",
            "has_gutters",
            "has_skylights",
            "has_chimney",
            "needs_cricket",
            "payment_type",
            "financing_down_payment",
            "estimate_goal",
            "measurement_verified",
            "job_questions_completed",
          ].join(", ")
        )
        .eq("id", estimateId)
        .single();

      if (error) {
        setErrorMessage(error.message);
      } else {
        const loaded = data as Estimate;
        setEstimate(loaded);

        setRoofAreaSf(toInputValue(loaded.roof_area_sf));
        setRoofSquares(toInputValue(loaded.roof_squares));
        setWastePercent(toInputValue(loaded.waste_percent ?? 10));
        setWasteSquares(toInputValue(loaded.waste_squares));
        setPitch(loaded.pitch ?? "");
        setEavesLf(toInputValue(loaded.eaves_lf));
        setRakesLf(toInputValue(loaded.rakes_lf));
        setHipsLf(toInputValue(loaded.hips_lf));
        setRidgesLf(toInputValue(loaded.ridges_lf));
        setValleysLf(toInputValue(loaded.valleys_lf));
        setFlashingLf(toInputValue(loaded.flashing_lf));
        setStepFlashingLf(toInputValue(loaded.step_flashing_lf));
        setDripEdgeLf(toInputValue(loaded.drip_edge_lf));
        setStarterLf(toInputValue(loaded.starter_lf));
        setRidgeCapLf(toInputValue(loaded.ridge_cap_lf));
        setStories(loaded.stories ?? "");

        setJobType(loaded.job_type ?? "Insurance");
        setEstimateGoal(loaded.estimate_goal ?? "Best Value");
        setPaymentType(loaded.payment_type ?? "Cash");
        setFinancingDownPayment(toInputValue(loaded.financing_down_payment));

        setHasSolar(Boolean(loaded.has_solar));
        setHasGutters(Boolean(loaded.has_gutters));
        setHasSkylights(Boolean(loaded.has_skylights));
        setHasChimney(Boolean(loaded.has_chimney));
        setNeedsCricket(Boolean(loaded.needs_cricket));
      }

      setLoading(false);
    }

    loadEstimate();
  }, [estimateId]);

  function calculateWasteSquares() {
    const squares = Number(roofSquares);
    const waste = Number(wastePercent);

    if (Number.isNaN(squares) || Number.isNaN(waste)) return;

    const calculated = squares * (1 + waste / 100);
    setWasteSquares(calculated.toFixed(2));
  }

  async function saveQuestions() {
    if (!estimate) return;

    setErrorMessage("");
    setSuccessMessage("");

    if (!roofSquares.trim()) {
      setErrorMessage("Roof squares are required before generating options.");
      return;
    }

    setSaving(true);

    const { error } = await supabase
      .from("estimates")
      .update({
        roof_area_sf: toNumber(roofAreaSf),
        roof_squares: toNumber(roofSquares),
        waste_percent: toNumber(wastePercent),
        waste_squares: toNumber(wasteSquares),
        pitch: pitch.trim() || null,
        eaves_lf: toNumber(eavesLf),
        rakes_lf: toNumber(rakesLf),
        hips_lf: toNumber(hipsLf),
        ridges_lf: toNumber(ridgesLf),
        valleys_lf: toNumber(valleysLf),
        flashing_lf: toNumber(flashingLf),
        step_flashing_lf: toNumber(stepFlashingLf),
        drip_edge_lf: toNumber(dripEdgeLf),
        starter_lf: toNumber(starterLf),
        ridge_cap_lf: toNumber(ridgeCapLf),
        stories: stories.trim() || null,

        job_type: jobType,
        estimate_goal: estimateGoal,
        payment_type: paymentType,
        financing_down_payment:
          paymentType === "Financing" ? toNumber(financingDownPayment) : null,

        has_solar: hasSolar,
        has_gutters: hasGutters,
        has_skylights: hasSkylights,
        has_chimney: hasChimney,
        needs_cricket: needsCricket,

        measurement_verified: true,
        job_questions_completed: true,
        status: "Draft - Pending Information",
      })
      .eq("id", estimate.id);

    setSaving(false);

    if (error) {
      setErrorMessage(error.message);
      return;
    }

    setSuccessMessage("Measurements and job questions saved.");
    router.push(`/estimates/${estimate.id}/options`);
  }

  if (loading) {
    return (
      <main className="min-h-screen bg-slate-100 p-8">
        <div className="rounded-xl bg-white p-6 shadow">
          Loading job questions...
        </div>
      </main>
    );
  }

  if (!estimate) {
    return (
      <main className="min-h-screen bg-slate-100 p-8">
        <div className="rounded-xl bg-white p-6 shadow">
          Estimate not found.
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-100">
      <div className="flex">
        <AppSidebar active="Estimates" />

        <section className="min-h-screen flex-1 p-6 lg:ml-[var(--sidebar-width)]">
          <div className="mb-6 flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
            <div>
              <button
                onClick={() => router.push(`/estimates/${estimate.id}`)}
                className="mb-3 text-sm font-bold text-slate-600 hover:text-slate-900"
              >
                ← Back to Estimate
              </button>

              <h1 className="text-4xl font-bold text-slate-900">
                Verify Measurements & Job Questions
              </h1>

              <p className="mt-1 text-lg text-slate-600">
                {estimate.customer_name || "Unnamed Customer"} ·{" "}
                {estimate.property_address || "No address"}
              </p>
            </div>

            <span className={getStatusBadge(estimate.status)}>
              {estimate.status || "No Status"}
            </span>
          </div>

          {errorMessage && (
            <div className="mb-6 rounded-lg bg-red-50 p-4 text-sm font-semibold text-red-700">
              {errorMessage}
            </div>
          )}

          {successMessage && (
            <div className="mb-6 rounded-lg bg-green-50 p-4 text-sm font-semibold text-green-700">
              {successMessage}
            </div>
          )}

          <div className="grid gap-6 xl:grid-cols-[1fr_360px]">
            <div className="space-y-6">
              <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div className="border-b border-slate-200 px-5 py-4">
                  <h2 className="text-sm font-black uppercase tracking-wide text-slate-800">
                    Measurement Verification
                  </h2>
                </div>

                <div className="grid gap-4 p-5 md:grid-cols-3">
                  <NumberField
                    label="Roof Area SF"
                    value={roofAreaSf}
                    onChange={setRoofAreaSf}
                  />
                  <NumberField
                    label="Roof Squares"
                    value={roofSquares}
                    onChange={setRoofSquares}
                    required
                  />
                  <NumberField
                    label="Waste %"
                    value={wastePercent}
                    onChange={setWastePercent}
                  />

                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Waste Squares
                    </label>
                    <div className="flex gap-2">
                      <input
                        value={wasteSquares}
                        onChange={(e) => setWasteSquares(e.target.value)}
                        className="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm"
                      />
                      <button
                        type="button"
                        onClick={calculateWasteSquares}
                        className="rounded-lg border border-slate-300 px-3 text-xs font-bold text-slate-700 hover:bg-slate-50"
                      >
                        Calc
                      </button>
                    </div>
                  </div>

                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Pitch
                    </label>
                    <input
                      value={pitch}
                      onChange={(e) => setPitch(e.target.value)}
                      placeholder="Example: 6/12"
                      className="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm"
                    />
                  </div>

                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Stories
                    </label>
                    <select
                      value={stories}
                      onChange={(e) => setStories(e.target.value)}
                      className="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm"
                    >
                      <option value="">Select</option>
                      <option value="One Story">One Story</option>
                      <option value="Two Story">Two Story</option>
                      <option value="Three Story">Three Story</option>
                    </select>
                  </div>

                  <NumberField label="Eaves LF" value={eavesLf} onChange={setEavesLf} />
                  <NumberField label="Rakes LF" value={rakesLf} onChange={setRakesLf} />
                  <NumberField label="Hips LF" value={hipsLf} onChange={setHipsLf} />
                  <NumberField label="Ridges LF" value={ridgesLf} onChange={setRidgesLf} />
                  <NumberField label="Valleys LF" value={valleysLf} onChange={setValleysLf} />
                  <NumberField label="Flashing LF" value={flashingLf} onChange={setFlashingLf} />
                  <NumberField label="Step Flashing LF" value={stepFlashingLf} onChange={setStepFlashingLf} />
                  <NumberField label="Drip Edge LF" value={dripEdgeLf} onChange={setDripEdgeLf} />
                  <NumberField label="Starter LF" value={starterLf} onChange={setStarterLf} />
                  <NumberField label="Ridge Cap LF" value={ridgeCapLf} onChange={setRidgeCapLf} />
                </div>
              </div>

              <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div className="border-b border-slate-200 px-5 py-4">
                  <h2 className="text-sm font-black uppercase tracking-wide text-slate-800">
                    Job Questions
                  </h2>
                </div>

                <div className="grid gap-4 p-5 md:grid-cols-2">
                  <SelectField
                    label="Retail or Insurance"
                    value={jobType}
                    onChange={setJobType}
                    options={["Insurance", "Retail", "Upgrade / Add-on", "Repair"]}
                  />

                  <SelectField
                    label="Estimate Goal"
                    value={estimateGoal}
                    onChange={setEstimateGoal}
                    options={["Cheapest Option", "Best Value", "Premium Option"]}
                  />

                  <SelectField
                    label="Payment Type"
                    value={paymentType}
                    onChange={setPaymentType}
                    options={["Cash", "Financing"]}
                  />

                  {paymentType === "Financing" && (
                    <NumberField
                      label="Planned Money Down"
                      value={financingDownPayment}
                      onChange={setFinancingDownPayment}
                    />
                  )}
                </div>

                <div className="grid gap-3 border-t border-slate-200 p-5 md:grid-cols-2">
                  <CheckboxField label="Solar Present" value={hasSolar} onChange={setHasSolar} />
                  <CheckboxField label="Gutters / Downspouts Involved" value={hasGutters} onChange={setHasGutters} />
                  <CheckboxField label="Skylights Present" value={hasSkylights} onChange={setHasSkylights} />
                  <CheckboxField label="Chimney Present" value={hasChimney} onChange={setHasChimney} />
                  <CheckboxField label="Cricket Needed" value={needsCricket} onChange={setNeedsCricket} />
                </div>
              </div>
            </div>

            <aside className="space-y-6">
              <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div className="border-b border-slate-200 px-5 py-4">
                  <h2 className="text-sm font-black uppercase tracking-wide text-slate-800">
                    Next Step
                  </h2>
                </div>

                <div className="space-y-4 p-5">
                  <p className="text-sm text-slate-600">
                    Save verified measurements and job questions before
                    generating estimate options.
                  </p>

                  <button
                    onClick={saveQuestions}
                    disabled={saving}
                    className="w-full rounded-lg bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700 disabled:opacity-50"
                  >
                    {saving ? "Saving..." : "Save & Generate Options"}
                  </button>
                </div>
              </div>

              <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div className="border-b border-slate-200 px-5 py-4">
                  <h2 className="text-sm font-black uppercase tracking-wide text-slate-800">
                    Quick Links
                  </h2>
                </div>

                <div className="space-y-3 p-5">
                  <Link
                    href={`/estimates/${estimate.id}/measurements`}
                    className="block rounded-lg border border-slate-300 px-4 py-3 text-center text-sm font-bold text-slate-700 hover:bg-slate-50"
                  >
                    Measurement Upload
                  </Link>

                  <Link
                    href={`/estimates/${estimate.id}`}
                    className="block rounded-lg border border-slate-300 px-4 py-3 text-center text-sm font-bold text-slate-700 hover:bg-slate-50"
                  >
                    Estimate Detail
                  </Link>
                </div>
              </div>
            </aside>
          </div>
        </section>
      </div>
    </main>
  );
}

function NumberField({
  label,
  value,
  onChange,
  required = false,
}: {
  label: string;
  value: string;
  onChange: (value: string) => void;
  required?: boolean;
}) {
  return (
    <div>
      <label className="mb-2 block text-sm font-bold text-slate-700">
        {label} {required ? "*" : ""}
      </label>
      <input
        type="number"
        value={value}
        onChange={(e) => onChange(e.target.value)}
        className="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm"
      />
    </div>
  );
}

function SelectField({
  label,
  value,
  onChange,
  options,
}: {
  label: string;
  value: string;
  onChange: (value: string) => void;
  options: string[];
}) {
  return (
    <div>
      <label className="mb-2 block text-sm font-bold text-slate-700">
        {label}
      </label>
      <select
        value={value}
        onChange={(e) => onChange(e.target.value)}
        className="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm"
      >
        {options.map((option) => (
          <option key={option} value={option}>
            {option}
          </option>
        ))}
      </select>
    </div>
  );
}

function CheckboxField({
  label,
  value,
  onChange,
}: {
  label: string;
  value: boolean;
  onChange: (value: boolean) => void;
}) {
  return (
    <label className="flex items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700">
      <input
        type="checkbox"
        checked={value}
        onChange={(e) => onChange(e.target.checked)}
        className="h-4 w-4"
      />
      {label}
    </label>
  );
}